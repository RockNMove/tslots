# .env — скопируй в .env и заполни реальными значениями
# Никогда не коммить .env в git!

# МойСклад API токен без ''
MS_TOKEN=токен_здесь

# PostgreSQL
# На сервере: смени DB_USER (не admin/postgres), DB_PASSWORD на надёжный,
# DB_PORT на нестандартный из диапазона 49152-65535 (например 58432)
DB_HOST=postgres
DB_USER=admin
DB_PASSWORD=admin
DB_NAME=tslots

# Порты сервисов
# На сервере можно сменить на нестандартные из диапазона 49152-65535
DB_PORT=5432
PREFECT_PORT=4200
METABASE_PORT=3000

# Бэкап
BACKUP_KEEP_DAYS=7

# S3 для бэкапов (раскомментировать когда настроишь)
# S3_BUCKET=your-bucket-name
# AWS_ACCESS_KEY_ID=
# AWS_SECRET_ACCESS_KEY=

# Адрес сервера — используется в Prefect UI для обращения к API из браузера.
# Локально: localhost
# На сервере: внешний IP или домен (без порта, без http://)
SERVER_HOST=localhost

# Логин и пароль для доступа к Prefect UI (Basic Auth через Nginx)
PREFECT_USER=admin
PREFECT_PASSWORD=admin

